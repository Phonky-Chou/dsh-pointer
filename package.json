{
  "name": "dsh-pointer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "In-preview element pointer (指代器) for DSH: pick elements inside previewable documents and feed structured context to the agent",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
